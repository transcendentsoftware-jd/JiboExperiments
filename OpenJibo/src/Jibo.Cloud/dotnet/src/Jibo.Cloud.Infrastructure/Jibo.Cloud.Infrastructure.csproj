<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<ProjectReference Include="..\Jibo.Cloud.Application\Jibo.Cloud.Application.csproj" />
		<ProjectReference Include="..\Jibo.Cloud.Domain\Jibo.Cloud.Domain.csproj" />
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Content\LegacyMims\BuildA\**\*.mim">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Content\LegacyMims\BuildA\README.md">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Content\LegacyMims\BuildB\**\*.mim">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Content\LegacyMims\BuildB\README.md">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Content\LegacyMims\Greetings\**\*.mim">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Content\LegacyMims\ReportSkill\**\*.mim">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Content\HolidayCountdownCatalog.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Content\MeasurementConversionCatalog.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\..\..\..\..\infra\postgresql\runtime-usage-delivery-role.sql"
		         Link="Deployment\runtime-usage-delivery-role.sql"
		         CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Azure.Storage.Blobs" Version="12.28.0" />
	  <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
	  <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
	  <!-- Security patch for SqlClient's transitive PKCS dependency (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
	  <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
	  <PackageReference Include="Npgsql" Version="9.0.5" />
	  <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
	  <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
	</ItemGroup>

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

</Project>
