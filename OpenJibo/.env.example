# Format: backend!credential!model
# - Wolfram: credential is the App ID (model omitted)
# - ChatGPT: credential is the API key (model optional, defaults to gpt-5.4-nano)
# - Ollama: credential is the base URL (optional, defaults to http://127.0.0.1:11434)
#           model optional, defaults to llama3.1:8b
# Use "none" or leave unset to disable knowledge search.
OPENJIBO_SEARCH_BACKEND=none

# Isolated self-hosting permits local ws:// connections by default for stock robots.
# Set to true to require direct wss:// connections even in isolated mode.
# Managed and hybrid deployments always require secure WebSockets; this setting
# cannot weaken their transport policy.
# OpenJibo__Security__Mode=false

# Optional fallback backend in the same format, tried when primary fails.
OPENJIBO_SEARCH_FALLBACK=

# Optional LLM personality/instructions for Ollama and ChatGPT backends.
# When unset, the built-in Jibo prompt in JiboKnowledgeSearchPrompts.cs is used.
# Use \n for line breaks in .env, or point InstructionsFile at a text file instead.
# OPENJIBO_SEARCH_INSTRUCTIONS=You are a helpful robot.\nKeep answers short.
# OPENJIBO_SEARCH_INSTRUCTIONS_FILE=search-instructions.txt

# Environment variables for encryption.
# After setting these values, DO NOT CHANGE THEM!!! THESE ARE USED TO ENCRYPT AND DECRYPT THE USER'S DATA.
# IF YOU CHANGE THEM, THE USER'S DATA WILL BE UNRECOVERABLE.
# !!!!!!!!!REPLACE WITH YOUR OWN VALUES!!!!!!!!!
OPENJIBO_USER_ENCRYPT="A_Very_Long_And_Strong_Secret_Passphrase_123!"
OPENJIBO_USER_SALT="g7f8e9d0c1b2a3f4e5d6c7b8a9012345"
# !!!!!!!!!REPLACE WITH YOUR OWN VALUES!!!!!!!!!

# Fresh Compose installations keep encrypted integration credentials on api-data.
# Existing .env files are preserved by initialization. Before adding this setting
# to an existing installation, retain and migrate its current file as documented
# in docs/self-hosted-recovery.md; do not strand it in a replaced container.
OpenJibo__UserIntegrations__PersistencePath=/data/user-integrations.json

# Self-hosted local speech-to-text (whisper.cpp), built into the api/migrate image.
# Set to false to skip building whisper.cpp entirely, e.g. if you only plan to use Azure Speech.
OPENJIBO_ENABLE_LOCAL_WHISPER=true
# Any model name accepted by whisper.cpp's download-ggml-model.sh, e.g. base.en, small.en.
OPENJIBO_WHISPER_MODEL=base.en
# Override whisper-cli / model when not using the Docker image defaults.
# CRITICAL: this must be whisper.cpp's whisper-cli binary, NOT OpenAI's Python `whisper`.
# OPENJIBO_STT_WHISPER_CLI_PATH=/usr/bin/whisper.cpp/build/bin/whisper-cli
# OPENJIBO_STT_WHISPER_MODEL_PATH=/usr/bin/whisper.cpp/models/ggml-base.en.bin
# OPENJIBO_STT_WHISPER_AUDIO_CTX=512
# OPENJIBO_STT_WHISPER_BEAM_SIZE=1
# Optional warm whisper-server for sub-second STT (model stays resident).
# The API process autostarts a loopback whisper-server when local whisper.cpp STT is enabled
# (dotnet run, published binary, and Docker). Default URL uses 8090 so it does not collide
# with the API on 8080. Set OPENJIBO_STT_ENABLE_WHISPER_SERVER=false to disable.
# OPENJIBO_STT_ENABLE_WHISPER_SERVER=true
# OPENJIBO_STT_AUTOSTART_WHISPER_SERVER=true
# OPENJIBO_STT_WHISPER_SERVER_URL=http://127.0.0.1:8090
# OPENJIBO_STT_WHISPER_SERVER_BIN=/usr/bin/whisper.cpp/build/bin/whisper-server

# When true, robots must be paired to an OpenJibo account before using cloud skills.
# Unset or false preserves the legacy open-access behavior.
OPENJIBO_USER_REQUIRED_LOGIN=false
